---
import Layout from "../layouts/Layout.astro";
---

<Layout title="会社概要 | つむぎネットワークス合同会社">
  <div class="page-header">
    <div class="container">
      <span class="en">COMPANY</span>
      <h1>会社概要</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <dl class="company-list">
        <div class="company-row">
          <dt>会社名</dt>
          <dd>つむぎネットワークス合同会社</dd>
        </div>
        <div class="company-row">
          <dt>設立</dt>
          <dd>2026年11月</dd>
        </div>
        <div class="company-row">
          <dt>代表社員</dt>
          <dd>
            <img src="/owner.png" alt="" class="protected-img" />
          </dd>
        </div>
        <div class="company-row">
          <dt>電話番号</dt>
          <dd>
            <img src="/tel.png" alt="" class="protected-img" />
          </dd>
        </div>
        <div class="company-row">
          <dt>住所</dt>
          <dd>
            福岡県福津市
          </dd>
        </div>
        <div class="company-row">
          <dt>事業内容</dt>
          <dd>
            1. ネットワークインフラ全般 (ご提案・選定/設計/構築等)<br />
            2. IT・DX推進に関するコンサルティング業務<br />
            3. デジタルコンテンツの企画、制作及び販売
          </dd>
        </div>
        <div class="company-row">
          <dt>主要取引銀行</dt>
          <dd>〇〇銀行 〇〇支店</dd>
        </div>
        <div class="company-row">
          <dt>コーポレートURL</dt>
          <dd>https://tsumugi-net.com/</dd>
        </div>
      </dl>
    </div>
  </section>
</Layout>

<style>
  .company-list {
    border-top: 1px solid #cbd5e1;
  }
  .company-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    border-bottom: 1px solid #e2e8f0;
    padding: 22px 8px;
  }
  .company-row dt {
    font-weight: 600;
    color: #0f172a;
    font-size: 0.95rem;
  }
  .company-row dd {
    color: #334155;
    font-size: 0.95rem;
  }
  .protected-img {
    height: 20px;
    width: auto;
    display: inline-block;
    vertical-align: -2px; /* 縦位置の微調整 */
    mix-blend-mode: multiply; /* 画像の白背景を馴染ませる */
    user-select: none;
    -webkit-user-select: none;
    pointer-events: none;
  }
  @media (max-width: 768px) {
    .company-row {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 18px 4px;
    }
  }
</style>