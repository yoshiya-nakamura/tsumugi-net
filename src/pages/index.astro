---
import { createClient } from "microcms-js-sdk";

// microCMSから「お知らせ（news）」を取得（※エンドポイント名が blogs 等の場合はここを変更）
const client = createClient({
  serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN,
  apiKey: import.meta.env.MICROCMS_API_KEY,
});

let newsList: any[] = [];
try {
  // エンドポイント名に合わせて "news" や "blogs" を指定してください
  const response = await client.get({ endpoint: "blogs", queries: { limit: 5 } });
  newsList = response.contents;
} catch (e) {
  console.error("microCMS取得エラー（エンドポイント名を確認してください）:", e);
}
---

