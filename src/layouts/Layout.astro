---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = "つむぎネットワークス合同会社の公式コーポレートサイトです。",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <!-- 共通ヘッダー -->
    <header class="header">
      <div class="container header-inner">
        <a href="/" class="logo">
          <img src="/corporate-logo.jpg" alt="つむぎネットワークス合同会社" class="header-logo-img" />
        </a>

        <!-- PC用ナビゲーション -->
        <nav class="nav pc-nav">
          <a href="/service">事業内容</a>
          <a href="/info">お知らせ</a>
          <a href="/company">会社概要</a>
          <a href="#contact" class="nav-cta">お問い合わせ</a>
        </nav>

        <!-- スマホ用ハンバーガーボタン -->
        <button
          type="button"
          id="menu-toggle"
          class="menu-toggle"
          aria-label="メニューを開く"
          aria-expanded="false"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

      <!-- スマホ用ドロワーメニュー -->
      <nav id="sp-nav" class="sp-nav">
        <a href="/">トップページ</a>
        <a href="/service">事業内容</a>
        <a href="/info">お知らせ</a>
        <a href="/company">会社概要</a>
        <a href="#contact" class="sp-nav-cta">お問い合わせ</a>
      </nav>
    </header>

    <!-- 各ページの中身 -->
    <main>
      <slot />
    </main>

    <!-- 共通お問い合わせエリア -->
    <section id="contact" class="contact-section">
      <div class="container contact-inner">
        <span class="en light">CONTACT</span>
        <h2>お問い合わせ</h2>
        <p>事業に関するご相談・お見積りなど、下記窓口よりお気軽にお問い合わせください。</p>

        <div class="mail-copy-box">
          <span id="contact-email" class="email-text">contact@tsumugi-net.com</span>
          <button type="button" id="copy-btn" class="copy-btn">コピー</button>
        </div>

        <div class="contact-actions">
          <a
            href="https://mail.google.com/mail/?view=cm&fs=1&to=contact@tsumugi-net.com"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-btn"
          >
            Gmailで問い合わせる
          </a>
          <a href="mailto:contact@tsumugi-net.com" class="contact-btn-sub">
            メールソフトを起動
          </a>
        </div>
      </div>
    </section>

    <!-- 共通フッター -->
    <footer class="footer">
      <div class="container footer-inner">
        <a href="/" class="footer-logo-wrap">
          <img src="/corporate-logo.jpg" alt="つむぎネットワークス合同会社" class="footer-logo-img" />
        </a>
        <div class="footer-links">
          <a href="/service">事業内容</a>
          <a href="/info">お知らせ</a>
          <a href="/company">会社概要</a>
        </div>
        <p class="copyright">&copy; {new Date().getFullYear()} TSUMUGI NETWORKS LLC. All Rights Reserved.</p>
      </div>
    </footer>

    <script>
      // メールコピー機能
      const copyBtn = document.getElementById("copy-btn");
      const emailText = document.getElementById("contact-email")?.textContent;

      copyBtn?.addEventListener("click", async () => {
        if (!emailText) return;
        await navigator.clipboard.writeText(emailText);
        copyBtn.textContent = "コピー完了！";
        setTimeout(() => {
          copyBtn.textContent = "コピー";
        }, 2000);
      });

      // スマホ用ハンバーガーメニュー開閉
      const menuToggle = document.getElementById("menu-toggle");
      const spNav = document.getElementById("sp-nav");

      menuToggle?.addEventListener("click", () => {
        const isOpen = spNav?.classList.toggle("is-open");
        menuToggle.classList.toggle("is-active");
        menuToggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
      });

      spNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          spNav.classList.remove("is-open");
          menuToggle?.classList.remove("is-active");
          menuToggle?.setAttribute("aria-expanded", "false");
        });
      });
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html {
    scroll-behavior: smooth;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif;
    color: #1e293b;
    line-height: 1.75;
    background-color: #ffffff;
  }
  .container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ヘッダー */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #e2e8f0;
  }
  .header-inner {
    height: 70px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .header-logo-img {
    height: 36px; /* ロゴの見た目に合わせて 32px〜44px の間で微調整してください */
    width: auto;
    display: block;
    object-fit: contain;
  }

  .pc-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .pc-nav a {
    color: #475569;
    text-decoration: none;
    transition: color 0.2s;
  }
  .pc-nav a:hover {
    color: #1d4ed8;
  }
  .nav-cta {
    background: #0f172a;
    color: #ffffff !important;
    padding: 8px 18px;
    border-radius: 6px;
  }
  .nav-cta:hover {
    background: #1d4ed8;
  }

  /* スマホ用メニュー（PCでは非表示） */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .menu-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: #0f172a;
    transition: transform 0.25s, opacity 0.25s;
  }
  .menu-toggle.is-active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle.is-active span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.is-active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .sp-nav {
    display: none;
    flex-direction: column;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 12px 24px 24px;
  }
  .sp-nav.is-open {
    display: flex;
  }
  .sp-nav a {
    padding: 14px 4px;
    color: #1e293b;
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid #f1f5f9;
  }
  .sp-nav a.sp-nav-cta {
    margin-top: 14px;
    background: #0f172a;
    color: #ffffff;
    text-align: center;
    border-radius: 6px;
    border-bottom: none;
    font-weight: 600;
  }

  /* 下層ページ共通ヘッダー */
  .page-header {
    padding: 64px 0 52px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }
  .page-header h1 {
    font-size: 2rem;
    color: #0f172a;
    margin-top: 4px;
  }

  /* セクション共通 */
  .section {
    padding: 80px 0;
  }
  .bg-light {
    background-color: #f8fafc;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
  }
  .section-head {
    margin-bottom: 40px;
  }
  .en {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #1d4ed8;
    margin-bottom: 4px;
  }
  .section-head h2 {
    font-size: 1.6rem;
    font-weight: 700;
    color: #0f172a;
  }
  .more-wrap {
    margin-top: 32px;
    text-align: right;
  }
  .more-link {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1d4ed8;
    text-decoration: none;
  }
  .more-link:hover {
    text-decoration: underline;
  }

  /* お問い合わせ */
  .contact-section {
    padding: 80px 0;
    background: #0f172a;
    color: #ffffff;
  }
  .contact-inner {
    text-align: center;
  }
  .en.light {
    color: #60a5fa;
  }
  .contact-inner h2 {
    font-size: 1.75rem;
    margin-bottom: 14px;
  }
  .contact-inner p {
    color: #cbd5e1;
    margin-bottom: 28px;
    font-size: 0.95rem;
  }
  .mail-copy-box {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 10px 14px 10px 20px;
    border-radius: 8px;
    margin-bottom: 24px;
    max-width: 100%;
  }
  .email-text {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #ffffff;
    word-break: break-all;
  }
  .copy-btn {
    background: #1d4ed8;
    color: #ffffff;
    border: none;
    padding: 7px 14px;
    border-radius: 5px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .copy-btn:hover {
    background: #2563eb;
  }
  .contact-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .contact-btn {
    display: inline-block;
    background: #ffffff;
    color: #0f172a;
    font-weight: 700;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 6px;
    font-size: 0.92rem;
    transition: background 0.2s;
  }
  .contact-btn:hover {
    background: #eff6ff;
  }
  .contact-btn-sub {
    display: inline-block;
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    font-weight: 600;
    text-decoration: none;
    padding: 14px 28px;
    border-radius: 6px;
    font-size: 0.92rem;
    transition: background 0.2s;
  }
  .contact-btn-sub:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* フッター */
  .footer {
    background: #090d16;
    color: #94a3b8;
    padding: 44px 0;
    font-size: 0.85rem;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-logo-wrap {
    display: inline-flex;
    align-items: center;
    background: #ffffff;
    padding: 6px 12px;
    border-radius: 6px;
    text-decoration: none;
  }
  .footer-logo-img {
    height: 28px;
    width: auto;
    display: block;
    object-fit: contain;
  }
  .footer-links {
    display: flex;
    gap: 24px;
  }
  .footer-links a {
    color: #cbd5e1;
    text-decoration: none;
  }
  .footer-links a:hover {
    color: #ffffff;
  }

  /* スマホ表示（768px以下） */
  @media (max-width: 768px) {
    .container {
      padding: 0 18px;
    }
    .header-inner {
      height: 60px;
    }
    .header-logo-img {
      height: 30px;
    }
    .pc-nav {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .section {
      padding: 56px 0;
    }
    .section-head {
      margin-bottom: 28px;
    }
    .section-head h2 {
      font-size: 1.4rem;
    }
    .page-header {
      padding: 44px 0 36px;
    }
    .page-header h1 {
      font-size: 1.55rem;
    }
    .contact-section {
      padding: 60px 0;
    }
    .contact-inner h2 {
      font-size: 1.45rem;
    }
    .mail-copy-box {
      width: 100%;
      padding: 10px 12px 10px 14px;
    }
    .email-text {
      font-size: 0.9rem;
    }
    .contact-actions {
      flex-direction: column;
    }
    .contact-btn,
    .contact-btn-sub {
      width: 100%;
      text-align: center;
    }
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>